# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon PostgreSQL Connection String (configure at least one in Vercel / .env)
DATABASE_URL="postgresql://USER:PASSWORD@ep-your-neon-host.region.aws.neon.tech/neondb?sslmode=require"
POSTGRES_URL=""
POSTGRES_PRISMA_URL=""

# Session signing secret (use a strong random 32+ char secret in production)
SESSION_SECRET="replace-with-a-secure-random-session-secret"
